{
    "name": "webware/webware-message",
    "description": "A Sessions backed flash messenger for Mezzio",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "mezzio",
        "message abstraction",
        "flash messenger"
    ],
    "homepage": "https://github.com/orgs/webinertia/discussions",
    "support": {
        "issues": "https://github.com/webinertia/webware-message/issues",
        "chat": "https://discord.gg/9TxQ74EPsG"
    },
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net"
        }
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "mezzio/mezzio-session": "^1.17.0",
        "mezzio/mezzio-session-ext": "^1.21.0",
        "webware/message-bus": "^2.0.0-beta.1"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "laminas/laminas-diactoros": "^3.6.0",
        "laminas/laminas-view": "^3.1.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.3.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/messagebus-event": "^2.0.0-beta.1",
        "webware/webware-tools": "^0.1.x-dev"
    },
    "suggest": {
        "laminas/laminas-view": "Required when the consuming application does not provide the HelperPluginManager service used by the SystemMessenger view helper"
    },
    "extra": {
        "laminas": {
            "config-provider": "Webware\\Message\\ConfigProvider"
        }
    },
    "autoload": {
        "psr-4": {
            "Webware\\Message\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\Message\\": "test/unit/",
            "WebwareTestIntegration\\Message\\": "test/integration/"
        }
    },
    "scripts": {
        "test-all": [
            "@test",
            "@test-integration"
        ],
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        }
    }
}
